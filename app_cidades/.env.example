# App web interno (VD): https://vd.telefarmed.com.br
# Produção por cliente: https://vd-{slug}.telefarmed.com.br
# Deploy: build único na Vercel + tenant em runtime (ver docs/vercel-vd-app-wildcard.md)
# EXPO_PUBLIC_APP_WEB_URL=https://vd.telefarmed.com.br

# API backend — Expo web local usa localhost:3001 (cross-origin).
# Após login, os tokens ficam no localStorage (PWA); reinicie backend e faça login de novo se ver 401.
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# Corrida/caminhada: `true` usa API VD run-walk (padrão); `false` mantém apenas cache local
EXPO_PUBLIC_RUN_WALK_API=true

# Slug da entidade em dev (native ou localhost sem host vd-{slug})
# EXPO_PUBLIC_ENTIDADE_SLUG=minha-cidade

# Fallback local quando tenant não carrega (opcional)
# EXPO_PUBLIC_LOGO_URL=assets/logo.png
# EXPO_PUBLIC_BACKGROUND_IMAGE_URL=assets/fundo_login_claro.png
# EXPO_PUBLIC_MUNICIPALITY_NAME=São Paulo

# URLs separadas por vírgula ou JSON: ["https://.../banner1.jpg","https://.../banner2.jpg"]
EXPO_PUBLIC_PROMO_BANNERS=
# Subdomínio do Ready Player Me (use "demo" para testes)
EXPO_PUBLIC_RPM_SUBDOMAIN=demo
# Compartilhamento ao vivo entre dispositivos (Supabase)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Em produção o app usa https://seguranca.telefarmed.com.br/{token}
# Só defina se quiser forçar outra URL (ex.: dev local):
# OpenAI — geração de cardápio (teste local; chave exposta no bundle)
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
